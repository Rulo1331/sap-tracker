# Copia este archivo a .streamlit/secrets.toml para probar localmente
# igual que en Streamlit Cloud. NUNCA subas secrets.toml real a GitHub
# (está en .gitignore, pero doble cuidado).
#
# En Streamlit Cloud, estos mismos valores se configuran desde:
# tu app -> Settings -> Secrets (en el dashboard, no en el repo).

FIORI_URL = "https://tu-servidor-fiori.com/sap/bc/ui2/flp"
SAP_USER = "tu_usuario"
SAP_PASSWORD = "tu_password"
